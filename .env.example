# Copy to apps/web/.env.local for local development. Never commit real values.
# Real values for preview/staging/production live in Vercel project settings.

# "local" | "preview" | "staging" | "production" (gates staging-only routes such as /design)
NEXT_PUBLIC_APP_ENV=local

# Absolute site URL for Open Graph / canonical links. Optional on Vercel (derived automatically).
# NEXT_PUBLIC_SITE_URL=https://example.com
