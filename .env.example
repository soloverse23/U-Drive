# Copy to apps/web/.env.local for local development. Never commit real values.
# Real values for preview/staging/production live in Vercel project settings.

# "local" | "preview" | "staging" | "production" (gates staging-only routes such as /design)
NEXT_PUBLIC_APP_ENV=local

# Absolute site URL for Open Graph / canonical links. Optional on Vercel (derived automatically).
# NEXT_PUBLIC_SITE_URL=https://example.com

# Supabase (EU). Local values: `pnpm --filter @u-drive/db exec supabase status`.
# Publishable key is safe in the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never expose to the browser or commit.
SUPABASE_SECRET_KEY=
