{
  "name": "@u-drive/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:start": "supabase start -x studio,imgproxy,vector,logflare,edge-runtime,postgres-meta,supavisor",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "test:db": "supabase test db",
    "gen:types": "supabase gen types typescript --local --schema public > src/database.types.ts && prettier --write src/database.types.ts"
  },
  "devDependencies": {
    "supabase": "^2.122.0"
  }
}
